{
  "can_query_users": {
    "operationId": ["usuarios.listar_usuarios", "usuarios.exportar_usuarios"],
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia", "profesor_academia": "own_academia"},
    "enforced_filters": { "academia_id": "current_user.academia_id" },
    "note": "Listado/exportar listado de usuarios: admin_plataforma puede consultar todos; admin_academia y profesor_academia sólo su propia academia"
  },

  "can_create_user": {
    "operationId": "usuarios.crear_usuario",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope": "own_academia",
    "allowed_target_roles": {
      "admin_plataforma": ["admin_plataforma", "admin_academia", "profesor_academia"],
      "admin_academia": ["admin_academia", "profesor_academia"]
    },
    "note": "Admin_academia puede crear usuarios solo en su academia y no puede crear Admin_plataforma"
  },

  "can_modify_user": {
    "operationId": ["usuarios.actualizar_usuario_put", "usuarios.actualizar_usuario_patch"],
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope_by_role": {
      "admin_plataforma": "global",
      "admin_academia": "own_academia",
      "profesor_academia": "own_user"
    },
    "mutable_fields_by_role": {
      "admin_plataforma": ["rol", "email", "estado", "nombre"],
      "admin_academia": ["email", "nombre", "estado"],
      "profesor_academia": ["email", "nombre", "password"]
    },
    "note": "Permisos de modificación por rol y ámbito"
  },

  "can_delete_user": {
    "operationId": "usuarios.eliminar_usuario",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": { "admin_plataforma": "global", "admin_academia": "own_academia" },
    "note": "Admin_academia solo puede borrar usuarios de su propia academia"
  },

  "can_query_academias": {
    "operationId": "academias.listar_academias",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia", "profesor_academia": "own_academia"},
    "enforced_filters": { "id": "current_user.academia_id" },
    "note": "Listado de academias: admin_plataforma puede listar todas; admin_academia y profesor_academia sólo su propia academia"
  },

  "can_create_academia": {
    "operationId": "academias.crear_academia",
    "allowed_roles": ["admin_plataforma"],
    "scope": "global"
  },

  "can_modify_academia": {
    "operationId": "academias.modificar_academia",
    "allowed_roles": ["admin_academia", "admin_plataforma"],
    "scope_by_role": { "admin_academia": "own_academia", "admin_plataforma": "global" }
  },

  "can_delete_academia": {
    "operationId": "academias.eliminar_academia",
    "allowed_roles": ["admin_plataforma"],
    "scope": "global"
  }
,
  "can_view_academia": {
    "operationId": "academias.obtener_academia",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia", "profesor_academia": "own_academia"},
    "note": "Lectura de academia: admin_plataforma global; admin_academia/profesor_academia limitados a su propia academia"
  },

  "can_login": {
    "operationId": "login.login",
    "allowed_roles": [],
    "scope": "public",
    "note": "Login público (no requiere rol)"
  },

  "can_logout": {
    "operationId": "login.logout",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope": "own_user",
    "note": "Logout para usuarios autenticados"
  },

  "can_refresh": {
    "operationId": "login.refresh_tokens",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope": "own_user",
    "note": "Refresh de tokens para usuarios autenticados"
  },

  "can_unblock": {
    "operationId": "login.unblock_user",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "note": "Desbloqueo de usuarios: admin_plataforma global; admin_academia su academia"
  },

  "can_view_my_profile": {
    "operationId": "usuarios.obtener_mi_perfil",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope": "own_user",
    "note": "Cada usuario puede ver su propio perfil; admins pueden verlo según su scope"
  },

  "can_view_user": {
    "operationId": "usuarios.obtener_usuario",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia", "profesor_academia": "own_academia"},
    "note": "Lectura de usuario: admin_plataforma global; admin_academia y profesor_academia limitados a su academia"
  },

  "can_query_roles": {
    "operationId": "roles.listar_roles",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope": "global",
    "transform_to": null,
    "note": "Listado de roles disponibles: todos los usuarios autenticados pueden consultar para conocer los roles disponibles al crear/modificar usuarios. transform_to=null evita transformación automática a roles.obtener_role"
  },

  "can_recover_credentials": {
    "operationId": "usuarios.recuperar_credenciales",
    "allowed_roles": [],
    "scope": "own_user",
    "note": "Recuperación de credenciales: la operación puede iniciarse sin sesión (por ejemplo 'forgot password'), pero solo debe permitir recuperar las credenciales del propio usuario. Los admins pueden tener flujos separados para administrar credenciales de otros usuarios."
  },

  "can_modify_credentials": {
    "operationId": "usuarios.actualizar_credenciales",
    "allowed_roles": ["admin_plataforma", "admin_academia", "profesor_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia", "profesor_academia": "own_user"},
    "mutable_fields_by_role": {
      "admin_plataforma": ["password", "email", "nombre", "rol", "academia_id", "estado"],
      "admin_academia": ["password", "email", "nombre", "rol", "academia_id", "estado"],
      "profesor_academia": ["password", "email", "nombre"]
    },
    "note": "Modificación de credenciales/propio perfil"
  },

  "can_modify_role": {
    "operationId": "usuarios.actualizar_rol",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "note": "Cambio de rol: admin_academia limitado a su academia"
  },

  "can_modify_status": {
    "operationId": "usuarios.actualizar_estado",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "note": "Cambio de estado de usuario: admins"
  },

  "can_query_tarifas": {
    "operationId": "tarifas.listar_tarifas",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "enforced_filters": { "academia_id": "current_user.academia_id" },
    "note": "Listado de tarifas: admin_plataforma puede ver todas; admin_academia solo de su academia"
  },

  "can_create_tarifa": {
    "operationId": "tarifas.crear_tarifa",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "note": "Crear tarifa: admin_plataforma requiere academia_id; admin_academia usa su academia vinculada"
  },

  "can_view_tarifa": {
    "operationId": "tarifas.obtener_tarifa",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "note": "Ver tarifa: admin_plataforma puede ver cualquiera; admin_academia solo de su academia"
  },

  "can_modify_tarifa": {
    "operationId": ["tarifas.actualizar_tarifa_put", "tarifas.actualizar_tarifa_patch"],
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "mutable_fields": ["descripcion", "precio_base"],
    "note": "Modificar tarifa: admin_plataforma puede modificar cualquiera; admin_academia solo de su academia"
  },

  "can_delete_tarifa": {
    "operationId": "tarifas.eliminar_tarifa",
    "allowed_roles": ["admin_plataforma", "admin_academia"],
    "scope_by_role": {"admin_plataforma": "global", "admin_academia": "own_academia"},
    "note": "Eliminar tarifa (soft-delete): admin_plataforma puede eliminar cualquiera; admin_academia solo de su academia. Bloqueado si hay cursos activos asociados"
  }
}
